---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Queue from '../../../components/Queue.astro';
import Stamp from '../../../components/Stamp.astro';
import Gallery from '../../../components/Gallery.astro';
import DownloadMenu from '../../../components/DownloadMenu.astro';
import { fileSize, fileUrl, safeName, mb, FORMAT_NOTES } from '../../../lib/files';
import Icon from '../../../components/Icon.astro';
import PlayButton from '../../../components/PlayButton.astro';
import VinylCover from '../../../components/VinylCover.astro';
import { printedTrackStyle } from '../../../lib/back-cover-tracks';
import {
  getCatalog,
  releaseUrl,
  trackUrl,
  fmtTime,
  fmtTotal,
  fmtDate,
  playable,
  hasAudio,
  isUnfinished,
  type Release,
} from '../../../lib/catalog';
import { site } from '../../../site';
import { statSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { graph, band, bandRef, website, breadcrumbs, abs, isoDuration } from '../../../lib/seo';

export const getStaticPaths = (async () => {
  const { releases } = await getCatalog();
  return releases.map((release, i) => ({
    params: { release: release.id },
    props: { release, newer: releases[i - 1], older: releases[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { release, newer, older } = Astro.props as { release: Release; newer?: Release; older?: Release };
const { tracksOf } = await getCatalog();
const tracks = tracksOf(release.id);
const ready = tracks.filter(hasAudio);
const printedTracks = tracks.flatMap((track, position) => {
  const index = ready.indexOf(track);
  const style = printedTrackStyle(release.id, position);
  return index >= 0 && style ? [{ id: playable(track, release).id, index, title: track.data.title, style }] : [];
});
const unfinished = isUnfinished(release);
const total = tracks.reduce((s, t) => s + t.data.duration, 0);
const { Content } = await render(release);
const hasNotes = Boolean(release.body?.trim());
const d = release.data;

// the whole record as one zip, in any format every track has, put together in
// the browser (src/lib/album-zip.ts); the m4a are the site's, the rest come from
// the download server (src/lib/files.ts)
const sizeOf = (src: string) => {
  const file = join(process.cwd(), 'public', src);
  return existsSync(file) ? statSync(file).size : 0;
};
const coverJpg = d.cover?.replace(/\.webp$/, '.jpg');
const cover = coverJpg && sizeOf(coverJpg) ? [{ name: 'cover.jpg', src: coverJpg, size: sizeOf(coverJpg) }] : [];
const zipFormats = (['mp3', 'flac', 'm4a'] as const)
  .map((format) => {
    const files = ready.map((t) => {
      const path = t.data.audio!.replace(/\.[^.]+$/, `.${format}`);
      const size = format === 'm4a' ? sizeOf(path) : (fileSize(path) ?? 0);
      return { name: `${String(t.data.number).padStart(2, '0')} ${safeName(t.data.title)}.${format}`, src: format === 'm4a' ? path : fileUrl(path), size };
    });
    return { format, files: [...files, ...cover], size: [...files, ...cover].reduce((n, f) => n + f.size, 0), complete: files.every((f) => f.size) };
  })
  .filter((f) => ready.length && f.complete);
const zipName = `Plausible Strangers - ${safeName(d.title)}`;
const zipReadme = [
  `${d.title} — Plausible Strangers`,
  `${d.kind}${d.catalog ? ` · ${d.catalog}` : ''}${!unfinished && d.date ? ` · ${fmtDate(d.date)}` : ''}`,
  '',
  ...ready.map((t) => `  ${String(t.data.number).padStart(2, ' ')}. ${t.data.title}  (${fmtTime(t.data.duration)})`),
  '',
  `${abs(releaseUrl(release.id))}`,
  '',
  `Licence: ${site.license.title} (${site.license.url}).`,
  'No rights reserved: play it, share it, remix it — no need to ask.',
  '',
].join('\n');
const zipPlan = JSON.stringify({ name: zipName, readme: zipReadme, formats: Object.fromEntries(zipFormats.map((f) => [f.format, f.files])) });
---

<Base
  title={d.title}
  image={d.cover?.replace(/\.webp$/, '.jpg')}
  imageAlt={`Cover of ${d.title} by Plausible Strangers`}
  description={`${d.title} — ${d.kind} by Plausible Strangers. ${tracks.length} tracks, ${Math.round(total / 60)} minutes.`}
  type="music.album"
  jsonLd={graph(
    {
      '@type': 'MusicAlbum',
      license: site.license.url,
      '@id': abs(releaseUrl(release.id)) + '#album',
      name: d.title,
      url: abs(releaseUrl(release.id)),
      byArtist: bandRef,
      image: d.cover ? abs(d.cover.replace(/\.webp$/, '.jpg')) : undefined,
      datePublished: d.date?.toISOString().slice(0, 10),
      albumProductionType: 'https://schema.org/StudioAlbum',
      albumReleaseType: d.kind.toLowerCase() === 'ep' ? 'https://schema.org/EPRelease' : 'https://schema.org/AlbumRelease',
      creativeWorkStatus: unfinished ? 'Unfinished' : 'Published',
      numTracks: tracks.length,
      duration: isoDuration(total),
      track: {
        '@type': 'ItemList',
        numberOfItems: tracks.length,
        itemListElement: tracks.map((t) => ({
          '@type': 'ListItem',
          position: t.data.number,
          item: {
            '@type': 'MusicRecording',
            name: t.data.title,
            url: abs(trackUrl(t)),
            duration: isoDuration(t.data.duration),
          },
        })),
      },
    },
    breadcrumbs([['plausible strangers.', '/'], ['records', '/#records'], [d.title, releaseUrl(release.id)]]),
  )}
>
  <Queue release={release} tracks={tracks} />

  <article class="release">
    {
      d.cover && (
        <figure class="release-cover">
          <VinylCover
            cover={d.cover}
            backCover={d.backCover}
            vinylLabel={d.vinylLabel}
            title={d.title}
            catalog={d.catalog}
            release={release.id}
            trackTitles={tracks.map((track) => track.data.title)}
            printedTracks={printedTracks}
            transitionName={`cover-${release.id}`}
          >
            {ready.length > 0 && (
              <PlayButton
                slot="expanded-controls"
                queue={release.id}
                index={0}
                id={playable(ready[0], release).id}
                record={release.id}
                label={`play or pause ${d.title}`}
                iconOnly
                class="play--icon"
              />
            )}
          </VinylCover>
        </figure>
      )
    }

    <div class="release-body">
    <header class="release-head">
      <p class="kicker"><a href="/#records">records</a> / {d.catalog}{unfinished && <Stamp />}</p>
      <h1 class="title">{d.title}</h1>
      <p class="meta">
        {d.kind} · {tracks.length} tracks · {fmtTotal(total)} · {unfinished ? (ready.length < tracks.length ? `in progress, ${ready.length} of ${tracks.length} audible so far` : 'in progress') : fmtDate(d.date)}
      </p>
      {ready.length > 0 && (
        <div class="track-actions release-actions">
          <PlayButton queue={release.id} index={0} id={playable(ready[0], release).id} record={release.id} label={unfinished ? 'play what exists' : 'play the record'} />
          {zipFormats.length > 0 && (
            <details class="dl-menu dl-menu--button" data-dl-menu>
              <summary class="download-btn" title={`all ${ready.length} tracks${cover.length ? ' and the cover' : ''} in one zip`}>
                <Icon name="download" /> {unfinished ? 'download what exists' : 'download the album'}
              </summary>
              <div class="dl-menu-list" data-album-zip={zipPlan}>
                {zipFormats.map((f) => (
                  <button type="button" class="dl-opt" data-album-zip-format={f.format}>
                    <span class="dl-format">{f.format}</span>
                    <span class="dl-note">{FORMAT_NOTES[f.format]}</span>
                    <span class="dl-size">{mb(f.size)}</span>
                  </button>
                ))}
              </div>
            </details>
          )}
          <a class="download-btn" href={`/booth/?release=${encodeURIComponent(release.id)}`}><Icon name="sine-wave" /> open in DJ booth</a>
        </div>
      )}
    </header>

    <ol class="tracklist">
      {
        tracks.map((t) => {
          const id = `${release.id}/${t.id.split('/').pop()!.replace(/^\d+-/, '')}`;
          const qi = ready.indexOf(t);
          return (
            <li class:list={['tl-row', { 'tl-row--silent': qi < 0 }]} data-row={id}>
              {qi >= 0 ? (
                <PlayButton queue={release.id} index={qi} id={id} label={`play ${t.data.title}`} iconOnly class="play--icon" />
              ) : (
                <span class="tl-silent" title="not audible yet">·</span>
              )}
              <span class="tl-n">{String(t.data.number).padStart(2, '0')}</span>
              <a class="tl-title" href={trackUrl(t)}>
                {t.data.title}
              </a>
              <span class="tl-dur">{fmtTime(t.data.duration)}</span>
              {qi >= 0 ? (
                <DownloadMenu audio={t.data.audio!} title={t.data.title} variant="icon" />
              ) : (
                <span />
              )}
            </li>
          );
        })
      }
    </ol>

    {
      hasNotes && (
        <section class="notes prose">
          <h2 class="label">notes</h2>
          <Content />
        </section>
      )
    }

    {d.suno && <p class="elsewhere"><a href={d.suno}>also on suno <Icon name="arrow-up-right" /></a></p>}

    </div>

  </article>

  <div class="release-after">
    <Gallery images={d.gallery} />

    <div class="release-foot">
    <nav class="pager" aria-label="other records">
      {newer ? <a href={releaseUrl(newer.id)} rel="prev">← {newer.data.title}</a> : <span />}
      {older ? <a href={releaseUrl(older.id)} rel="next">{older.data.title} →</a> : <span />}
    </nav>
    </div>
  </div>
</Base>

<style>
</style>

<script>
  import { initAlbumZip } from '../../../lib/album-zip';
  initAlbumZip();
</script>
