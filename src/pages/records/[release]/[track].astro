---
import Lyrics from '../../../components/Lyrics.astro';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Queue from '../../../components/Queue.astro';
import PlayButton from '../../../components/PlayButton.astro';
import VinylCover from '../../../components/VinylCover.astro';
import Wave from '../../../components/Wave.astro';
import SoundView from '../../../components/SoundView.astro';
import Stamp from '../../../components/Stamp.astro';
import DownloadMenu from '../../../components/DownloadMenu.astro';
import { downloadsFor } from '../../../lib/files';
import Icon from '../../../components/Icon.astro';
import StylePrompt from '../../../components/StylePrompt.astro';
import SoundStats from '../../../components/SoundStats.astro';
import {
  parseLyrics,
  songSections,
  stemsFor,
  stemsZipUrl,
  getCatalog,
  releaseUrl,
  trackUrl,
  trackSlug,
  fmtTime,
  fmtDate,
  keyName,
  trackAnalysis,
  getArchive,
  archiveUrl,
  songBase,
  playable,
  hasAudio,
  isUnfinished,
  isCopy,
  appearances,
  type Release,
  type Track,
} from '../../../lib/catalog';
import { site } from '../../../site';
import { graph, band, bandRef, website, breadcrumbs, abs, isoDuration } from '../../../lib/seo';

export const getStaticPaths = (async () => {
  const { releases, tracksOf } = await getCatalog();
  return releases.flatMap((release) => {
    const tracks = tracksOf(release.id);
    return tracks.map((track, i) => ({
      params: { release: release.id, track: trackSlug(track) },
      props: { release, tracks, index: i },
    }));
  });
}) satisfies GetStaticPaths;

const { release, tracks, index } = Astro.props as { release: Release; tracks: Track[]; index: number };
const track = tracks[index];
// the same recording on another record has its page there: send people on
if (isCopy(track)) return Astro.redirect(trackUrl(track), 301);
// every record this song is on, when it's more than one
const elsewhere = appearances(track).filter((p) => p.track.id !== track.id);
const t = track.data;
const r = release.data;
const audible = hasAudio(track);
const qi = tracks.filter(hasAudio).indexOf(track);
const p = playable(track, release);
const unfinished = isUnfinished(release);
const prev = tracks[index - 1];
const next = tracks[index + 1];
const analysis = audible ? trackAnalysis(track) : undefined;
// sung lines only (no [directions]), for search engines
const lyricText = t.instrumental
  ? undefined
  : parseLyrics(track.body)
      .flat()
      .filter((l) => !l.direction)
      .map((l) => l.text)
      .join('\n') || undefined;
// unreleased versions of this song in the archive (same base title)
const archiveVersions = (await getArchive()).filter((a) => songBase(a.data.title) === songBase(t.title));

const details: [string, string | undefined][] = [
  ['record', `${r.title} (${r.catalog})`],
  ['track', `${t.number} of ${tracks.length}`],
  [
    'also on',
    elsewhere.map((p) => `${p.release.data.title} (${p.release.data.catalog}), track ${p.track.data.number}`).join('; ') || undefined,
  ],
  ['length', fmtTime(t.duration)],
  ['tempo', t.bpm ? `${t.bpm} bpm` : undefined],
  ['key', t.key ? `${keyName(t.key)} (${t.key}, as detected)` : undefined],
  ['tags', t.tags],
  ['generated', t.created ? fmtDate(t.created) : undefined],
  ['machine', t.machine],
  ['human', 'idea, direction, selection, arrangement'],
];
---

<Base
  title={`${t.title} — ${r.title}`}
  image={r.cover?.replace(/\.webp$/, '.jpg')}
  imageAlt={`Cover of ${r.title} by Plausible Strangers`}
  description={`${t.title}, track ${t.number} of ${r.title} by Plausible Strangers${t.bpm ? `, ${t.bpm} bpm` : ''}${t.instrumental ? ', instrumental' : ''}. Lyrics, the prompt behind it, and how it sounds.`}
  type="music.song"
  jsonLd={graph(
    {
      '@type': 'MusicRecording',
      license: site.license.url,
      '@id': abs(trackUrl(track)) + '#recording',
      name: t.title,
      url: abs(trackUrl(track)),
      byArtist: bandRef,
      duration: isoDuration(t.duration),
      datePublished: t.created?.toISOString().slice(0, 10),
      genre: t.tags,
      image: r.cover ? abs(r.cover.replace(/\.webp$/, '.jpg')) : undefined,
      inAlbum: { '@type': 'MusicAlbum', name: r.title, url: abs(releaseUrl(release.id)), '@id': abs(releaseUrl(release.id)) + '#album' },
      audio: t.audio
        ? { '@type': 'AudioObject', contentUrl: abs(t.audio), encodingFormat: 'audio/mp4', duration: isoDuration(t.duration) }
        : undefined,
      recordingOf: lyricText
        ? {
            '@type': 'MusicComposition',
            name: t.title,
            lyrics: { '@type': 'CreativeWork', text: lyricText, inLanguage: 'en' },
          }
        : undefined,
      sameAs: t.suno ? [t.suno] : undefined,
    },
    breadcrumbs([
      ['plausible strangers.', '/'],
      [r.title, releaseUrl(release.id)],
      [t.title, trackUrl(track)],
    ]),
  )}
>
  <Queue release={release} tracks={tracks} />

  <article class="track track--clean">
    <div class="track-top">
    <header class="track-head">
      {
        r.cover && (
          <div class="track-cover">
            <VinylCover cover={r.cover} backCover={r.backCover} vinylLabel={r.vinylLabel} title={r.title} catalog={r.catalog} release={release.id} href={releaseUrl(release.id)} transitionName={`cover-${release.id}`} compact />
          </div>
        )
      }
      <div>
        <p class="kicker"><a href={releaseUrl(release.id)}>{r.title}</a> / {String(t.number).padStart(2, '0')}{unfinished && <Stamp />}</p>
        <h1 class="title">{t.title}</h1>
        <p class="meta">
          {fmtTime(t.duration)}{t.bpm && ` · ${t.bpm} bpm`}{t.key && ` · ${keyName(t.key)}`}{t.instrumental && ' · instrumental'}
        </p>
        <div class="track-actions">
          {audible ? (
            <>
              <PlayButton queue={release.id} index={qi} id={p.id} />
              <DownloadMenu audio={t.audio!} title={t.title} />
            </>
          ) : (
            <span class="meta">not audible yet. it exists, mostly.</span>
          )}
        </div>
      </div>
    </header>

    {
      audible &&
        (analysis || p.peaks.length ? (
          <SoundView analysis={analysis} id={p.id} peaks={p.peaks} src={t.audio} duration={t.duration} queue={release.id} index={qi} sections={songSections({ audio: t.audio, body: track.body, timed: p.lyrics, duration: t.duration })} stems={stemsFor(t.audio)} stemsZip={t.audio && stemsFor(t.audio)?.length ? stemsZipUrl(t.audio) : undefined} />
        ) : (
          <Wave id={p.id} peaks={p.peaks} duration={t.duration} queue={release.id} index={qi} class="wave--big" />
        ))
    }
    {audible && <noscript><audio controls preload="none" src={t.audio}></audio></noscript>}
    </div>

    <div class="track-main">
    <Lyrics body={track.body} audio={t.audio} instrumental={t.instrumental} trackId={p.id} timed={audible ? p.lyrics : undefined} />
    </div>

    <aside class="track-side">
    <section aria-labelledby="details-h">
      <h2 id="details-h" class="label">details</h2>
      <dl class="details">
        {
          details
            .filter(([, v]) => v)
            .map(([k, v]) => (
              <>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </>
            ))
        }
        {(t.audio || t.suno) && (
          <>
            <dt>{t.audio ? 'file' : 'elsewhere'}</dt>
            <dd>
              {t.audio && downloadsFor(t.audio, t.title).map((o, i) => <>{i > 0 && ' · '}<a class="dl-opt" href={o.href} download={o.name} data-dl-name={o.name}>{o.format}</a></>)}
              {t.audio && t.suno && ' · '}
              {t.suno && <a href={t.suno}>suno <Icon name="arrow-up-right" /></a>}
            </dd>
          </>
        )}
        <dt>license</dt>
        <dd>
          <a href={site.license.url} rel="license" title={site.license.title}>CC0 1.0</a> · free, no rights reserved
        </dd>
      </dl>
    </section>

    {analysis && <SoundStats analysis={analysis} id={p.id} queue={release.id} index={qi} part="energy" />}

    {
      t.notes && (
        <section aria-labelledby="notes-h">
          <h2 id="notes-h" class="label">notes</h2>
          <p>{t.notes}</p>
        </section>
      )
    }

    {
      archiveVersions.length > 0 && (
        <section class="versions" aria-labelledby="versions-h">
          <h2 id="versions-h" class="label">other versions, unreleased</h2>
          <ul class="plain versions-list">
            {archiveVersions.map((v) => (
              <li>
                <a href={archiveUrl(v)}>{v.data.title}</a> <span class="meta">unreleased</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {analysis && <SoundStats analysis={analysis} id={p.id} queue={release.id} index={qi} part="numbers" />}

    {t.style && <StylePrompt text={t.style} />}
    </aside>

    <nav class="pager" aria-label="other tracks">
      {prev ? <a href={trackUrl(prev)} rel="prev">← {prev.data.title}</a> : <a href={releaseUrl(release.id)}>← {r.title}</a>}
      {next ? <a href={trackUrl(next)} rel="next">{next.data.title} →</a> : <a href={releaseUrl(release.id)}>back to {r.title} ↑</a>}
    </nav>
  </article>
</Base>
