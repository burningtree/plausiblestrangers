---
// One unreleased song: in the backlog, not on a record (yet).
import Lyrics from '../../components/Lyrics.astro';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import DownloadMenu from '../../components/DownloadMenu.astro';
import OnPaper from '../../components/OnPaper.astro';
import Icon from '../../components/Icon.astro';
import PlayButton from '../../components/PlayButton.astro';
import Queue from '../../components/Queue.astro';
import PixelArt from '../../components/PixelArt.astro';
import SoundView from '../../components/SoundView.astro';
import StylePrompt from '../../components/StylePrompt.astro';
import SoundStats from '../../components/SoundStats.astro';
import Wave from '../../components/Wave.astro';
import {
  getArchive,
  playableArchive,
  archiveAnalysis,
  scoreFor,
  songSections,
  stemsFor,
  stemsZipUrl,
  getCatalog,
  archiveUrl,
  trackUrl,
  releaseUrl,
  songBase,
  fmtTime,
  fmtDate,
  type ArchiveSong,
} from '../../lib/catalog';
import { site } from '../../site';
import { graph, band, bandRef, website, breadcrumbs, abs, isoDuration } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const songs = await getArchive();
  return songs.map((song, i) => ({
    params: { song: song.id },
    props: { song, newer: songs[i - 1], older: songs[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { song, newer, older } = Astro.props as { song: ArchiveSong; newer?: ArchiveSong; older?: ArchiveSong };
const d = song.data;
const recording = playableArchive(song);
const analysis = recording ? archiveAnalysis(song) : undefined;
const score = recording ? scoreFor(d.audio) : undefined;

// other versions: released tracks and archive songs sharing the same base title
const base = songBase(d.title);
const { releases, tracksOf } = await getCatalog();
const releasedVersions = releases.flatMap((r) =>
  tracksOf(r.id)
    .filter((t) => songBase(t.data.title) === base)
    .map((t) => ({ title: t.data.title, url: trackUrl(t), where: r.data.title, whereUrl: releaseUrl(r.id) })),
);
const archiveVersions = (await getArchive()).filter((a) => a.id !== song.id && songBase(a.data.title) === base);

const details: [string, string | undefined][] = [
  ['status', 'unreleased'],
  ['length', d.duration ? fmtTime(d.duration) : undefined],
  ['tempo', d.bpm ? `${d.bpm} bpm` : undefined],
  ['tags', d.tags],
  ['generated', d.created ? fmtDate(d.created) : undefined],
  ['machine', d.machine],
  ['human', 'idea, direction, selection'],
];
---

<Base
  licensed={!d.remix}
  title={`${d.title} — unreleased`}
  description={`${d.title}: an unreleased Plausible Strangers song${d.bpm ? `, ${d.bpm} bpm` : ''}. Lyrics, the prompt, and a link to listen.`}
  type="music.song"
  jsonLd={graph(
    {
      '@type': 'MusicRecording',
      license: d.remix ? undefined : site.license.url,
      name: d.title,
      url: abs(archiveUrl(song)),
      byArtist: bandRef,
      duration: d.duration ? isoDuration(d.duration) : undefined,
      dateCreated: d.created?.toISOString().slice(0, 10),
      genre: d.tags,
      creativeWorkStatus: 'Unreleased',
      sameAs: d.suno ? [d.suno] : undefined,
    },
    breadcrumbs([['plausible strangers.', '/'], ['library', '/library/'], [d.title, archiveUrl(song)]]),
  )}
>
  <Queue archiveSong={song} />
  <article class="track track--clean archive-song">
    <div class="track-top">
      <header class="track-head">
        <div class="track-cover archive-art"><PixelArt seed={d.title} label={`pixel art for ${d.title}`} /></div>
        <div>
          <p class="kicker"><a href="/library/">library</a> <span class="stamp stamp--quiet">unreleased</span></p>
          <h1 class="title">{d.title}</h1>
          <p class="meta">
            {d.duration && fmtTime(d.duration)}{d.bpm && ` · ${d.bpm} bpm`}{score && ` · ${score.key}`}{d.instrumental && ' · instrumental'}{d.created && ` · ${fmtDate(d.created)}`}
          </p>
          <div class="track-actions">
            {
              recording ? (
                <>
                  <PlayButton queue={recording.id} index={0} id={recording.id} label="play" />
                  <DownloadMenu audio={recording.src} title={d.title} />
                  {d.suno && <a class="download-btn" href={d.suno}>on suno <Icon name="arrow-up-right" /></a>}
                  {d.ace && <a class="download-btn" href={d.ace}>on ace music <Icon name="arrow-up-right" /></a>}
                </>
              ) : d.suno ? (
                <a class="suno-btn" href={d.suno}>
                  <Icon name="play-solid" /> listen on suno <Icon name="arrow-up-right" />
                </a>
              ) : (
                <span class="meta">no recording kept.</span>
              )
            }
          </div>
        </div>
      </header>

      {
        recording &&
          (analysis || recording.peaks.length ? (
            <SoundView analysis={analysis} id={recording.id} peaks={recording.peaks} src={recording.src} duration={recording.duration} queue={recording.id} index={0} sections={songSections({ audio: d.audio, body: song.body, timed: recording.lyrics, duration: recording.duration })} stems={stemsFor(d.audio)} stemsZip={d.audio && stemsFor(d.audio)?.length && !d.remix ? stemsZipUrl(d.audio) : undefined} />
          ) : (
            <Wave id={recording.id} peaks={recording.peaks} duration={recording.duration} queue={recording.id} index={0} class="wave--big" />
          ))
      }
    </div>

    <div class="track-main">
      <Lyrics
        body={song.body}
        audio={d.audio}
        instrumental={d.instrumental}
        hiddenLyrics={d.lyricsHidden}
        trackId={recording?.id}
        timed={recording?.lyrics}
        score={score?.files.musicxml && recording ? { src: score.files.musicxml.src, bars: score.bars, id: recording.id, queue: recording.id, index: 0 } : undefined}
      />
    </div>

    <aside class="track-side">
      <section aria-labelledby="details-h">
        <h2 id="details-h" class="label">details</h2>
        <dl class="details">
          {
            details
              .filter(([, v]) => v)
              .map(([k, v]) => (
                <>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </>
              ))
          }
          {(d.suno || d.ace) && (
            <>
              <dt>elsewhere</dt>
              <dd>
                {d.suno && (
                  <a href={d.suno}>
                    suno <Icon name="arrow-up-right" />
                  </a>
                )}
                {d.ace && (
                  <a href={d.ace}>
                    ace music <Icon name="arrow-up-right" />
                  </a>
                )}
              </dd>
            </>
          )}
          <dt>license</dt>
          {d.remix ? (
            <dd>not ours to give away: a remix of someone else's song, so the original's rights apply</dd>
          ) : (
            <dd>
              <a href={site.license.url} rel="license" title={site.license.title}>CC0 1.0</a> · free, no rights reserved
            </dd>
          )}
        </dl>
      </section>

      {analysis && recording && <SoundStats analysis={analysis} id={recording.id} queue={recording.id} index={0} part="energy" />}

      {score && recording && <OnPaper score={score} title={d.title} id={recording.id} queue={recording.id} index={0} />}

      {
        d.notes && (
          <section aria-labelledby="notes-h">
            <h2 id="notes-h" class="label">notes</h2>
            <p>{d.notes}</p>
          </section>
        )
      }

      {
        (releasedVersions.length > 0 || archiveVersions.length > 0) && (
          <section class="versions" aria-labelledby="versions-h">
            <h2 id="versions-h" class="label">other versions</h2>
            <ul class="plain versions-list">
              {releasedVersions.map((v) => (
                <li>
                  <a href={v.url}>{v.title}</a> <span class="meta">on <a href={v.whereUrl}>{v.where}</a></span>
                </li>
              ))}
              {archiveVersions.map((v) => (
                <li>
                  <a href={archiveUrl(v)}>{v.data.title}</a> <span class="meta">unreleased</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {analysis && recording && <SoundStats analysis={analysis} id={recording.id} queue={recording.id} index={0} part="numbers" />}

      {d.style && <StylePrompt text={d.style} machine={d.machine} />}
    </aside>

    <nav class="pager" aria-label="other unreleased songs">
      {newer ? <a href={archiveUrl(newer)} rel="prev">← {newer.data.title}</a> : <a href="/library/">← library</a>}
      {older ? <a href={archiveUrl(older)} rel="next">{older.data.title} →</a> : <a href="/library/">library ↑</a>}
    </nav>
  </article>
</Base>
