---
import Icon from './Icon.astro';
// A text button that plays track `index` of a record's queue (see Queue.astro).
interface Props {
  queue: string;
  index: number;
  id: string;
  label?: string;
  iconOnly?: boolean;
  /** set for record-level buttons: any track of this record counts as "mine" (pause/resume, not restart) */
  record?: string;
  class?: string;
}
const { queue, index, id, label = 'play', iconOnly = false, record, class: className } = Astro.props;
---

<button
  type="button"
  class:list={['play', className]}
  data-play
  data-queue={queue}
  data-index={index}
  data-id={id}
  data-record={record}
  aria-pressed="false"
  aria-label={label}
>
  <span class="when-paused"><Icon name="play-solid" />{!iconOnly && <span class="play-label">{label}</span>}</span>
  <span class="when-playing"><Icon name="pause-solid" />{!iconOnly && <span class="play-label">pause</span>}</span>
</button>
