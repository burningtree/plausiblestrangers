---
// A text button that plays track `index` of a record's queue (see Queue.astro).
interface Props {
  queue: string;
  index: number;
  id: string;
  label?: string;
  iconOnly?: boolean;
  class?: string;
}
const { queue, index, id, label = 'play', iconOnly = false, class: className } = Astro.props;
---

<button
  type="button"
  class:list={['play', className]}
  data-play
  data-queue={queue}
  data-index={index}
  data-id={id}
  aria-pressed="false"
  aria-label={label}
>
  <span class="when-paused"><span aria-hidden="true">▶&#xFE0E;</span>{!iconOnly && ` ${label}`}</span>
  <span class="when-playing"><span aria-hidden="true">❚❚</span>{!iconOnly && ' pause'}</span>
</button>
