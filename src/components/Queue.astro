---
import { hasAudio, playable, playableArchive, type ArchiveSong, type Release, type Track } from '../lib/catalog';

type Props = { release: Release; tracks: Track[] } | { archiveSong: ArchiveSong };
const props = Astro.props;
const archive = 'archiveSong' in props ? playableArchive(props.archiveSong) : undefined;
const queue = 'release' in props ? props.release.id : archive?.id;
const items = 'release' in props
  ? props.tracks.filter(hasAudio).map((track) => playable(track, props.release))
  : archive ? [archive] : [];
const json = JSON.stringify(items).replace(/</g, '\\u003c');
---

{queue && <script type="application/json" data-queue={queue} set:html={json} />}
