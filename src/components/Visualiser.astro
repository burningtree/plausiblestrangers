---
// Full-screen visualiser: press "v" (or the "visualise" button in the player).
// The sound is turned into typed characters: a waterfall of the spectrum,
// bass in the middle, highs at the edges, scrolling upwards like a printout.
import Icon from './Icon.astro';
---

<div id="viz" class="viz" transition:persist="viz" hidden tabindex="-1" role="dialog" aria-modal="true" aria-label="visualiser">
  <canvas class="viz-canvas" aria-hidden="true"></canvas>
  <div class="viz-top">
    <span>plausible strangers. <span class="viz-dim">/ visualiser</span></span>
    <button type="button" class="viz-close" data-viz-close>close <kbd>v</kbd></button>
  </div>
  <div class="viz-bottom">
    <p class="viz-title"></p>
    <p class="viz-meta"><span class="viz-release"></span> <span class="viz-time"></span></p>
  </div>
  <p class="viz-lyric" aria-live="off"><span class="viz-lyric-on"></span><span class="viz-lyric-off"></span></p>
  <p class="viz-idle" hidden>silence. press <kbd>space</kbd>.</p>

  <!-- the same buttons as the player bar (they share its click handling) -->
  <div class="viz-controls" role="group" aria-label="playback">
    <button type="button" data-player="prev" aria-label="previous track" title="previous (p)"><Icon name="skip-prev" /></button>
    <button type="button" class="viz-toggle" data-player="toggle" aria-label="play / pause (space)" title="play / pause (space)">
      <span class="when-paused"><Icon name="play-solid" /></span>
      <span class="when-playing"><Icon name="pause-solid" /></span>
    </button>
    <button type="button" data-player="next" aria-label="next track" title="next (n)"><Icon name="skip-next" /></button>
    <span class="viz-sep" aria-hidden="true"></span>
    <button type="button" data-player="mute" aria-label="mute (m)" title="mute (m)">
      <Icon name="sound-high" class="vol-high" /><Icon name="sound-low" class="vol-low" /><Icon name="sound-off" class="vol-off" />
    </button>
    <input class="viz-vol" type="range" min="0" max="1" step="0.01" value="1" aria-label="volume" />
  </div>
</div>

<script>
  const RAMP = [' ', ' ', '·', '.', ':', '-', '=', '+', '*', '░', '▒', '▓', '█'];
  const ROW_MS = 55; // how often a new line is printed

  const viz = document.getElementById('viz') as HTMLElement;
  const canvas = viz.querySelector('canvas') as HTMLCanvasElement;
  const ctx2d = canvas.getContext('2d', { alpha: false })!;
  const audio = document.getElementById('ps-audio') as HTMLAudioElement;
  const $ = <T extends Element>(s: string) => viz.querySelector(s) as T;

  let actx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let bins: Uint8Array<ArrayBuffer> = new Uint8Array(0);
  let raf = 0;
  let last = 0;
  let cols = 0;
  let rows = 0;
  let cellW = 0;
  let cellH = 0;
  let dpr = 1;
  let colors = { paper: '#000', ink: '#fff', mute: '#888', hot: '#f50' };
  let smooth: Float32Array = new Float32Array(0);
  let bass = 0;
  let opener: Element | null = null;

  // Web Audio can only grab the <audio> element once, ever — keep it around.
  function ensureGraph() {
    if (analyser) return true;
    try {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      actx = new AC();
      const src = actx.createMediaElementSource(audio);
      analyser = actx.createAnalyser();
      analyser.fftSize = 4096;
      analyser.smoothingTimeConstant = 0.72;
      src.connect(analyser);
      analyser.connect(actx.destination);
      bins = new Uint8Array(analyser.frequencyBinCount);
      // let the player bar pulse with the real bass from now on
      const bass = new Uint8Array(analyser.frequencyBinCount);
      (window as any).__psViz = {
        // n log-spaced bands, 0–1, for the player's pixel matrix
        bands(n: number) {
          analyser!.getByteFrequencyData(bass);
          const nyq = actx!.sampleRate / 2;
          const out: number[] = [];
          for (let i = 0; i < n; i++) {
            const f0 = 40 * Math.pow(12000 / 40, i / n);
            const f1 = 40 * Math.pow(12000 / 40, (i + 1) / n);
            const b0 = Math.floor((f0 / nyq) * bass.length);
            const b1 = Math.max(b0 + 1, Math.floor((f1 / nyq) * bass.length));
            let m = 0;
            for (let b = b0; b < b1; b++) m = Math.max(m, bass[b]);
            out.push(Math.max(0, (m / 255 - 0.3) / 0.7) * (1 + (i / n) * 0.4));
          }
          return out;
        },
        level() {
          analyser!.getByteFrequencyData(bass);
          const nyq = actx!.sampleRate / 2;
          const hi = Math.ceil((140 / nyq) * bass.length);
          let m = 0;
          for (let i = 1; i <= hi; i++) m = Math.max(m, bass[i]);
          return Math.max(0, (m / 255 - 0.45) / 0.55);
        },
      };
      return true;
    } catch {
      return false;
    }
  }

  function readColors() {
    const cs = getComputedStyle(document.documentElement);
    const v = (n: string) => cs.getPropertyValue(n).trim();
    colors = { paper: v('--paper'), ink: v('--ink'), mute: v('--mute'), hot: v('--hot') };
  }

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    const w = innerWidth;
    const h = innerHeight;
    canvas.width = Math.floor(w * dpr);
    canvas.height = Math.floor(h * dpr);
    canvas.style.width = `${w}px`;
    canvas.style.height = `${h}px`;
    const size = w < 600 ? 11 : w > 1800 ? 15 : 13;
    ctx2d.setTransform(1, 0, 0, 1, 0, 0);
    ctx2d.scale(dpr, dpr);
    ctx2d.font = `${size}px ui-monospace, "SF Mono", Menlo, monospace`;
    ctx2d.textBaseline = 'top';
    cellW = ctx2d.measureText('█').width || size * 0.6;
    cellH = Math.round(size * 1.25);
    cols = Math.ceil(w / cellW);
    rows = Math.ceil(h / cellH);
    smooth = new Float32Array(cols);
    ctx2d.fillStyle = colors.paper;
    ctx2d.fillRect(0, 0, w, h);
  }

  // column → level, mirrored: bass in the middle, highs towards both edges
  function levels(): Float32Array {
    const out = new Float32Array(cols);
    if (!analyser || !actx) return out;
    analyser.getByteFrequencyData(bins);
    const nyq = actx.sampleRate / 2;
    const half = Math.ceil(cols / 2);
    const lo = 45;
    const hi = 16000;
    for (let i = 0; i < half; i++) {
      const f0 = lo * Math.pow(hi / lo, i / half);
      const f1 = lo * Math.pow(hi / lo, (i + 1) / half);
      const b0 = Math.floor((f0 / nyq) * bins.length);
      const b1 = Math.max(b0 + 1, Math.floor((f1 / nyq) * bins.length));
      let m = 0;
      for (let b = b0; b < b1 && b < bins.length; b++) m = Math.max(m, bins[b]);
      // tilt: highs are naturally quieter, lift them a little
      const v = Math.min(1, Math.pow(m / 255, 1.35) * (1 + (i / half) * 0.5));
      out[half - 1 - i] = v;
      out[cols - half + i] = v;
    }
    return out;
  }

  function printRow() {
    const w = innerWidth;
    const h = innerHeight;
    // scroll everything up by one line
    ctx2d.drawImage(canvas, 0, cellH * dpr, canvas.width, canvas.height - cellH * dpr, 0, 0, w, h - cellH);
    const y = (rows - 1) * cellH;
    ctx2d.fillStyle = colors.paper;
    ctx2d.fillRect(0, y, w, cellH + 2);
    const lv = levels();
    let b = 0;
    const mid = cols / 2;
    for (let c = 0; c < cols; c++) {
      smooth[c] = Math.max(lv[c], smooth[c] * 0.6);
      const v = smooth[c];
      if (Math.abs(c - mid) < cols * 0.06) b = Math.max(b, v);
      const ch = RAMP[Math.min(RAMP.length - 1, Math.floor(v * RAMP.length))];
      if (ch === ' ') continue;
      ctx2d.globalAlpha = 0.3 + v * 0.7;
      ctx2d.fillStyle = v > 0.97 && Math.random() < 0.6 ? colors.hot : colors.ink;
      ctx2d.fillText(ch, c * cellW, y);
    }
    ctx2d.globalAlpha = 1;
    bass = b;
  }

  // the line being sung, typed out as it is sung
  type Line = { text: string; t: number; e: number };
  let shownLine = -2;
  function lyricFrame() {
    const ps = (window as any).__ps;
    const lines: Line[] | undefined = ps?.current?.()?.lyrics;
    const el = $<HTMLElement>('.viz-lyric');
    if (!lines?.length) {
      el.classList.remove('is-on');
      shownLine = -2;
      return;
    }
    const now = audio.currentTime;
    let k = -1;
    for (let i = 0; i < lines.length; i++) if (lines[i].t <= now + 0.1) k = i;
    const line = lines[k];
    // keep a line up a little after it ends, unless the next one is close
    const visible = !!line && now < line.e + 1.6 && !(lines[k + 1] && lines[k + 1].t - now < 0.05);
    el.classList.toggle('is-on', visible);
    if (!line) return;
    if (k !== shownLine) {
      shownLine = k;
      el.classList.remove('is-new');
      void el.offsetWidth;
      el.classList.add('is-new');
    }
    const dur = Math.max(0.6, (line.e - line.t) * 0.85);
    const p = Math.min(1, Math.max(0, (now - line.t) / dur));
    const n = Math.ceil(line.text.length * p);
    $<HTMLElement>('.viz-lyric-on').textContent = line.text.slice(0, n);
    $<HTMLElement>('.viz-lyric-off').textContent = line.text.slice(n);
  }

  function frame(t: number) {
    raf = requestAnimationFrame(frame);
    lyricFrame();
    if (t - last < ROW_MS) return;
    last = t;
    printRow();
    const title = $<HTMLElement>('.viz-title');
    title.style.transform = `scale(${1 + bass * 0.035})`;
    title.style.letterSpacing = `${-0.03 + bass * 0.03}em`;
    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    $<HTMLElement>('.viz-time').textContent =
      audio.src && isFinite(audio.duration) ? `${fmt(audio.currentTime)} / ${fmt(audio.duration)}` : '';
    $<HTMLElement>('.viz-idle').hidden = !audio.paused;
  }

  function fillText() {
    const title = document.querySelector('#player .player-title')?.textContent || '';
    const release = document.querySelector('#player .player-release')?.textContent || '';
    $<HTMLElement>('.viz-title').textContent = title || 'nothing yet';
    $<HTMLElement>('.viz-release').textContent = release;
  }

  function open() {
    if (!viz.hidden) return;
    // nothing loaded? start the first thing on this page
    if (!audio.src) document.querySelector<HTMLElement>('[data-play]')?.click();
    if (!ensureGraph()) return;
    actx?.resume();
    // you opened it to watch something move
    if (audio.src && audio.paused) audio.play().catch(() => {});
    opener = document.activeElement;
    readColors();
    viz.hidden = false;
    wake();
    document.documentElement.classList.add('viz-open');
    resize();
    fillText();
    requestAnimationFrame(() => viz.classList.add('is-on'));
    viz.focus({ preventScroll: true });
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(frame);
  }

  function close() {
    if (viz.hidden) return;
    viz.classList.remove('is-on');
    document.documentElement.classList.remove('viz-open');
    cancelAnimationFrame(raf);
    setTimeout(() => {
      if (!viz.classList.contains('is-on')) viz.hidden = true;
    }, 350);
    (opener as HTMLElement | null)?.focus?.({ preventScroll: true });
  }

  const toggle = () => (viz.hidden ? open() : close());

  // ---- volume, mirrored from the player (the player owns the real setting)
  const vizVol = viz.querySelector<HTMLInputElement>('.viz-vol')!;
  function showVol() {
    const v = audio.muted ? 0 : audio.volume;
    vizVol.value = String(v);
    vizVol.style.setProperty('--v', `${v * 100}%`);
    viz.dataset.vol = v === 0 ? 'off' : v < 0.5 ? 'low' : 'high';
  }
  vizVol.addEventListener('input', () => {
    audio.volume = Number(vizVol.value);
    audio.muted = audio.volume === 0;
  });
  audio.addEventListener('volumechange', showVol);
  showVol();

  // ---- controls fade out while it plays and nobody moves; back on any movement
  let idle = 0;
  function wake() {
    viz.classList.add('ui-on');
    clearTimeout(idle);
    idle = window.setTimeout(() => {
      // stay up while paused, or while the pointer / focus is on the controls
      if (!audio.paused && !viz.querySelector('.viz-controls:hover, .viz-controls:focus-within')) viz.classList.remove('ui-on');
    }, 2600);
  }
  viz.addEventListener('pointermove', wake);
  viz.addEventListener('pointerdown', wake);
  viz.addEventListener('keydown', wake);
  audio.addEventListener('pause', () => viz.classList.add('ui-on'));
  audio.addEventListener('play', wake);

  document.addEventListener('keydown', (e) => {
    if (document.querySelector('dialog[open]')) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const el = (e.target instanceof Element ? e.target : document.body) as HTMLElement;
    if (el.closest('input, textarea, select, [contenteditable]')) return;
    if (e.key === 'v' || e.key === 'V') {
      e.preventDefault();
      toggle();
    } else if (e.key === 'Escape' && !viz.hidden) {
      close();
    }
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    if (t.closest('[data-viz-open]')) return open();
    if (t.closest('[data-viz-close]')) return close();
    // tapping the picture itself plays / pauses
    // tapping the picture itself plays / pauses (everything else is a control)
    if (t === canvas || t === viz || t.closest('.viz-bottom, .viz-lyric, .viz-idle')) {
      audio.paused ? audio.play().catch(() => {}) : audio.pause();
    }
  });
  audio.addEventListener('play', () => {
    actx?.resume();
    if (!viz.hidden) fillText();
  });
  audio.addEventListener('loadedmetadata', () => !viz.hidden && fillText());
  window.addEventListener('resize', () => !viz.hidden && resize());
  // theme switched while open
  new MutationObserver(() => {
    if (viz.hidden) return;
    readColors();
    resize();
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  // navigation swaps <html> classes — keep the scroll lock if still open
  document.addEventListener('astro:after-swap', () => {
    if (!viz.hidden) document.documentElement.classList.add('viz-open');
  });
</script>
