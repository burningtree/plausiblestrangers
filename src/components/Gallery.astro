---
import Icon from './Icon.astro';
import { blurStyle } from '../lib/catalog';
// Extra images for a record (concept art, outtakes). Thumbnails sit loosely
// like prints on a table; clicking one opens it big. ← → to browse, esc to close.
interface Props {
  images?: { src: string; alt: string; caption?: string }[];
  title?: string;
}
const { images = [], title = 'concept art' } = Astro.props;
const thumb = (src: string) => src.replace(/(\.[a-z]+)$/i, '-640$1');
---

{
  images.length > 0 && (
    <section class="gallery" aria-labelledby="gallery-h">
      <h2 id="gallery-h" class="label">
        {title} <span class="count">{images.length} images</span>
      </h2>
      <ul class="gallery-grid">
        {images.map((img, i) => (
          <li>
            <a class="gallery-item" href={img.src} data-gallery-index={i}>
              <img src={thumb(img.src)} class="blur" style={blurStyle(img.src)} alt={img.alt} width="640" height="640" loading="lazy" decoding="async" />
            </a>
            {img.caption && <p class="gallery-caption">{img.caption}</p>}
          </li>
        ))}
      </ul>

      <dialog class="lightbox" aria-label={title}>
        <figure>
          <img class="lightbox-img" src="" alt="" />
          <figcaption>
            <span class="lightbox-caption" />
            <span class="lightbox-count" />
          </figcaption>
        </figure>
        <button type="button" class="lightbox-btn lightbox-close" data-lb="close" aria-label="close"><Icon name="xmark" /> <kbd>esc</kbd></button>
        <button type="button" class="lightbox-btn lightbox-prev" data-lb="prev" aria-label="previous image"><Icon name="nav-arrow-left" /></button>
        <button type="button" class="lightbox-btn lightbox-next" data-lb="next" aria-label="next image"><Icon name="nav-arrow-right" /></button>
        <script type="application/json" set:html={JSON.stringify(images)} />
      </dialog>
    </section>
  )
}

<script>
  type Img = { src: string; alt: string; caption?: string };

  function setup() {
    const section = document.querySelector<HTMLElement>('.gallery');
    if (!section || section.dataset.ready) return;
    section.dataset.ready = '1';
    const dialog = section.querySelector('dialog') as HTMLDialogElement;
    const images: Img[] = JSON.parse(dialog.querySelector('script')!.textContent || '[]');
    const img = dialog.querySelector('.lightbox-img') as HTMLImageElement;
    let index = 0;

    const show = (i: number) => {
      index = (i + images.length) % images.length;
      const it = images[index];
      img.src = it.src;
      img.alt = it.alt;
      dialog.querySelector('.lightbox-caption')!.textContent = it.caption ?? '';
      dialog.querySelector('.lightbox-count')!.textContent = `${index + 1} / ${images.length}`;
      // warm up the neighbour
      new Image().src = images[(index + 1) % images.length].src;
    };

    section.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('[data-gallery-index]');
      if (!a) return;
      e.preventDefault();
      show(Number(a.dataset.galleryIndex));
      dialog.showModal();
    });
    dialog.addEventListener('click', (e) => {
      const t = e.target as Element;
      const action = t.closest<HTMLElement>('[data-lb]')?.dataset.lb;
      if (action === 'close' || t === dialog) dialog.close();
      else if (action === 'prev') show(index - 1);
      else if (action === 'next') show(index + 1);
      else if (t === img) show(index + 1);
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      else if (e.key === 'ArrowLeft') show(index - 1);
      else return;
      e.preventDefault();
      e.stopPropagation();
    });
    // swipe on touch screens
    let x0 = 0;
    dialog.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }

  document.addEventListener('astro:page-load', setup);
  setup();
</script>
