---
import { ClientRouter } from 'astro:transitions';
import Player from '../components/Player.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import Visualiser from '../components/Visualiser.astro';
import Palette from '../components/Palette.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  home?: boolean;
}
const { title, description = site.description, image, home = false } = Astro.props;
const fullTitle = title ? `${title} — plausible strangers` : 'plausible strangers.';
const imageUrl = image && Astro.site ? new URL(image, Astro.site).href : image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content={site.twitter} />
    {site.links.map((l) => <link rel="me" href={l.href} />)}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="plausible strangers. news" href="/rss.xml" />
    <script is:inline>
      // set the theme before first paint, so there is no flash
      try {
        var t = localStorage.getItem('ps:theme');
        document.documentElement.dataset.theme =
          t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch (e) {}
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    <nav class="corner" aria-label="menu">
      {
        // first, so pages without it (home) don't shift the other items
        !home && (
          <button type="button" class="corner-btn" data-random title="play a random track">
            <Icon name="dice-five" /> random
          </button>
        )
      }
      <a
        class="corner-btn"
        href="/news/"
        title="what happened lately"
        aria-current={Astro.url.pathname.startsWith('/news') ? 'page' : undefined}
      >
        <Icon name="journal" /> news
      </a>
      <a
        class="corner-btn"
        href="/about/"
        title="what this is"
        aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}
      >
        <Icon name="info-circle" /> about
      </a>
      <a
        class="corner-btn"
        href="/library/"
        title="everything, released or not"
        aria-current={Astro.url.pathname.startsWith('/library') ? 'page' : undefined}
      >
        <Icon name="book-stack" /> library
      </a>
      <Palette />
      <ThemeSwitch />
    </nav>
    <header class:list={['masthead', { 'masthead--home': home }]}>
      {home ? <h1 class="wordmark">{site.name}</h1> : <a class="wordmark" href="/">{site.name}</a>}
      {
        home && (
          <button type="button" class="random-big" data-random>
            <Icon name="dice-five" class="random-dice" /> play something random
          </button>
        )
      }
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="colophon">
      <p>
        No cookies, no analytics, no algorithm. Just files on a server. <a href="/about/">About us.</a><br />
        Sounds by machines, decisions by humans, mistakes by both.
      </p>
      <p class="keys">
        <span><kbd>space</kbd> play / pause</span>
        <span><kbd>←</kbd> <kbd>→</kbd> 10 seconds</span>
        <span><kbd>n</kbd> <kbd>p</kbd> next / previous</span>
        <span><kbd>m</kbd> mute</span>
        <span><kbd>v</kbd> visualise</span>
        <span><kbd class="palette-kbd">⌘K</kbd> or <kbd>/</kbd> search</span>
      </p>
    </footer>
    <Player />
    <Visualiser />
  </body>
</html>
