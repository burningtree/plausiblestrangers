---
import { ClientRouter } from 'astro:transitions';
import Player from '../components/Player.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import Visualiser from '../components/Visualiser.astro';
import Palette from '../components/Palette.astro';
import Icon from '../components/Icon.astro';
import Cc0Badge from '../components/Cc0Badge.astro';
import { site } from '../site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** share image (a .jpg works everywhere); defaults to the band picture */
  image?: string;
  imageAlt?: string;
  home?: boolean;
  /** Open Graph type: website, article, music.album, music.song, profile */
  type?: string;
  /** ISO date for articles */
  published?: Date;
  /** schema.org structured data for this page (see lib/seo.ts) */
  jsonLd?: unknown;
  /** keep this page out of search results (e.g. 404) */
  noindex?: boolean;
  /** false on pages whose music isn't ours to give away (remixes of others' songs) */
  licensed?: boolean;
  immersive?: boolean;
}
const {
  title,
  description = site.description,
  image,
  imageAlt,
  home = false,
  type = 'website',
  published,
  jsonLd,
  noindex = false,
  licensed = true,
  immersive = false,
} = Astro.props;
const fullTitle = home
  ? 'Plausible Strangers — human-directed, machine-generated electronic music'
  : title
    ? `${title} — plausible strangers`
    : 'plausible strangers.';
const SITE = Astro.site ?? new URL('https://plausiblestrangers.com');
const canonical = new URL(Astro.url.pathname, SITE).href;
const DEFAULT_IMAGE = '/art/about/plausible-strangers.jpg';
const imageUrl = new URL(image ?? DEFAULT_IMAGE, SITE).href;
const imageAltText = imageAlt ?? (image ? `Artwork for ${title ?? 'Plausible Strangers'}` : 'Two figures in the fog under the words PLAUSIBLE STRANGERS');
// JSON-LD is embedded as a script; escape "<" so text can't close the tag
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {licensed && <link rel="license" href={site.license.url} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content="Plausible Strangers" />
    <meta name="theme-color" content="#f7f6f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content="plausible strangers." />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAltText} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitter} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAltText} />
    {ld && <script type="application/ld+json" set:html={ld} />}
    {site.links.map((l) => <link rel="me" href={l.href} />)}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="plausible strangers. news" href="/rss.xml" />
    <script is:inline>
      // set the theme before first paint, so there is no flash
      try {
        var t = localStorage.getItem('ps:theme');
        document.documentElement.dataset.theme =
          t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch (e) {}
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={{ "immersive-layout": immersive }}>
    <a class="skip" href="#main">skip to content</a>
    <header class:list={['masthead', { 'masthead--home': home }]}>
      {
        // a link to home on every page, the home page included (where it's also the h1)
        home ? (
          <h1 class="wordmark"><a href="/">{site.name}</a></h1>
        ) : (
          <a class="wordmark" href="/">{site.name}</a>
        )
      }
      <Player />
      <nav class="corner" aria-label="menu">
        <a class="corner-btn" href="/" aria-current={home ? 'page' : undefined}>
          <Icon name="home" /> home
        </a>
        <a
          class="corner-btn"
          href="/about/"
          title="what this is"
          aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}
        >
          <Icon name="info-circle" /> about
        </a>
        <a
          class="corner-btn"
          href="/library/"
          title="everything, released or not"
          aria-current={Astro.url.pathname.startsWith('/library') ? 'page' : undefined}
        >
          <Icon name="book-stack" /> library
        </a>
        <a class="corner-btn" href="/booth/" aria-current={Astro.url.pathname.startsWith('/booth') ? 'page' : undefined}>booth</a>
        <Palette />
        <ThemeSwitch />
      </nav>
    </header>
    <script is:inline>
      // the sticky header's height, for anchors and anything else that must clear it
      (function () {
        var set = function () {
          var h = document.querySelector('.masthead');
          if (h) document.documentElement.style.setProperty('--head-h', h.offsetHeight + 'px');
        };
        if (!window.__headObs) {
          window.__headObs = new ResizeObserver(set);
          document.addEventListener('astro:page-load', function () {
            var h = document.querySelector('.masthead');
            if (h) window.__headObs.observe(h);
            set();
          });
        }
        var h = document.querySelector('.masthead');
        if (h) window.__headObs.observe(h);
        set();
      })();
    </script>
    <main id="main">
      <slot />
    </main>
    <footer class="colophon">
      <div class="colophon-free">
        <Cc0Badge />
        <p>
          All our music is public domain (CC0). Use it however you like, no need to ask or credit us.
          Our remixes of other artists' songs excepted. <a href="/about/#free">Why?</a>
        </p>
      </div>
      <p>
        No cookies, no analytics, no algorithm. Just files on a server. <a href="/about/">About us.</a><br />
        Sounds by machines, decisions by humans, mistakes by both.
      </p>
      <p class="keys">
        <span><kbd>space</kbd> play / pause</span>
        <span><kbd>←</kbd> <kbd>→</kbd> 10 seconds</span>
        <span><kbd>n</kbd> <kbd>p</kbd> next / previous</span>
        <span><kbd>m</kbd> mute</span>
        <span><kbd>v</kbd> visualise</span>
        <span><kbd class="palette-kbd">⌘K</kbd> or <kbd>/</kbd> search</span>
      </p>
    </footer>
    <Visualiser />
  </body>
</html>
